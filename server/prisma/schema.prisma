generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(MANAGEMENT)
  createdAt       DateTime        @default(now())
  loginActivities LoginActivity[]
  transactions    Transaction[]   @relation("UserTransactions")
}

model Account {
  id             String        @id @default(uuid())
  accountName    String
  initialBalance Decimal       @default(0) @db.Decimal(14, 2)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transactions   Transaction[]

  @@index([isActive])
}

model Category {
  id           String          @id @default(uuid())
  categoryName String
  type         TransactionType
  parentId     String?
  createdAt    DateTime        @default(now())

  parent       Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]      @relation("CategoryHierarchy")
  transactions Transaction[]

  @@unique([categoryName, type])
  @@index([parentId])
}

model Transaction {
  id              String          @id @default(uuid())
  date            DateTime
  categoryId      String
  accountId       String
  description     String?
  amount          Decimal         @db.Decimal(14, 2)
  transactionType TransactionType
  uniqueCode      String?
  attachmentUrl   String?         
  createdById     String
  createdAt       DateTime        @default(now())

  category        Category        @relation(fields: [categoryId], references: [id])
  account         Account         @relation(fields: [accountId], references: [id])
  createdBy       User            @relation("UserTransactions", fields: [createdById], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([createdById])
  @@index([transactionType])
}

model LoginActivity {
  id                          String      @id @default(uuid())
  emailAttempted              String
  userId                      String?
  status                      LoginStatus
  ipAddress                   String
  userAgent                   String?
  browser                     String?
  os                          String?
  city                        String?
  country                     String?
  isNewDevice                 Boolean     @default(false)
  isNewLocation               Boolean     @default(false)
  failedAttemptsBeforeSuccess Int         @default(0)
  createdAt                   DateTime    @default(now())

  user                        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([emailAttempted])
  @@index([createdAt])
}

enum Role {
  ADMIN
  STAFF
  MANAGEMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoginStatus {
  SUCCESS
  FAILED
}
