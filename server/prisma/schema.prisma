// Prisma schema for the Corporate Financial Reporting application.
// Run `npx prisma generate` after filling in DATABASE_URL in .env,
// then `npx prisma migrate dev --name init` to create the tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  MANAGEMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoginStatus {
  SUCCESS
  FAILED
}


model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(MANAGEMENT)
  createdAt       DateTime        @default(now())
  transactions    Transaction[]   @relation("UserTransactions")
  loginActivities LoginActivity[]
}

model Category {
  id           String          @id @default(uuid())
  categoryName String
  type         TransactionType

  parentId     String?
  parent       Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]      @relation("CategoryHierarchy")

  createdAt    DateTime        @default(now())
  transactions Transaction[]

  @@unique([categoryName, type])
  @@index([parentId])
}

model Transaction {
  id              String          @id @default(uuid())
  date            DateTime
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description     String?
  amount          Decimal         @db.Decimal(14, 2)
  transactionType TransactionType
  uniqueCode      String?
  createdById     String
  createdBy       User            @relation("UserTransactions", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([date])
  @@index([categoryId])
  @@index([createdById])
  @@index([transactionType])
}

model LoginActivity {
  id             String      @id @default(uuid())

  emailAttempted String

  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  status         LoginStatus

  ipAddress      String
  userAgent      String?
  browser        String?
  os             String?
  city           String?     
  country        String?     

  isNewDevice    Boolean     @default(false)
  isNewLocation  Boolean     @default(false)

  failedAttemptsBeforeSuccess Int @default(0)

  createdAt      DateTime    @default(now())

  @@index([userId])
  @@index([emailAttempted])
  @@index([createdAt])
}