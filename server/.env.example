# Prisma database connection string.
# Replace with your real PostgreSQL connection details.
DATABASE_URL="postgresql://user:password@localhost:5432/db_name"

# JWT secret used to sign session tokens (httpOnly cookie auth).
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated list of allowed CORS origins (the Next.js app URL).
CLIENT_URL="http://localhost:3000"

# Port the Express API server listens on.
PORT=4000
